{
  "name": "fasaadgov-v02",
  "version": "2.0.0",
  "description": "Enhanced FasaadGov Sankey visualization with modular architecture and advanced features",
  "main": "sankey.html",
  "type": "module",
  "scripts": {
    "dev": "http-server -p 8080 -c-1",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "validate": "node scripts/validate-data.js",
    "build": "node scripts/build.js",
    "serve": "http-server -p 8080"
  },
  "keywords": [
    "visualization",
    "sankey",
    "d3",
    "corporate-complicity",
    "data-visualization"
  ],
  "author": "FasaadGov Team",
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.12.0",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "dependencies": {
    "d3": "^7.8.5"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js"
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "es2021": true,
      "jest": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-console": "warn",
      "prefer-const": "error"
    }
  }
}